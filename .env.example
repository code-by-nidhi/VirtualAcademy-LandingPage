# Copy this file to .env.local and fill in the values (see README.md → "Google Sheet setup").

# Web app URL from Apps Script → Deploy → New deployment (ends with /exec)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Must match SECRET in google-apps-script/Code.gs. Use a long random string.
GOOGLE_SHEET_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
